NODE_ENV=production
HOST=0.0.0.0
PORT=3002
DATABASE_URL=file:/data/devfast.db
JWT_SECRET=change-me-generate-a-long-random-secret

# Gmail SMTP example. Use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_HELO=devfast.local
